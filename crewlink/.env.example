# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=crewlink
POSTGRES_USER=crewlink
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port exposed on your machine (change if 5432 is already used)
POSTGRES_HOST_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Next.js ---
# Used by the Next.js server (inside Docker) to reach Django
BACKEND_INTERNAL_URL=http://backend:8000

# --- Demo seed ---
# Password for the seeded demo logins (default if unset: crewlink-demo-pass)
# SEED_PASSWORD=crewlink-demo-pass

# --- AI drafting (server-side only; never sent to the browser) ---
# fake = no network, no key (default). anthropic = real provider.
AI_PROVIDER=fake
# AI_FAKE_MODE=ok            # ok | fail | timeout | invalid (demo the failure paths)
# AI_API_KEY=                # required only for AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-5-5  # verify the model id for your account
# AI_TIMEOUT_SECONDS=8
# AI_MAX_RETRIES=1
